/target

# Wine 11.0 build + the "webview2" bottle (see README.md's "WebView2 under
# Wine" section) - large (multi-GB), machine-specific binary artifacts, not
# project source.
/.wine

# Zig toolchain used by `cargo zigbuild` to cross-compile browser-wx to
# Windows (see README.md's "browser-wx: building and running" section) -
# a large, machine-specific binary artifact, not project source.
/.zig

# macOS SDK (framework .tbd stubs etc.) used by `cargo zigbuild` to
# cross-compile browser-macos-appkit from Linux (see README.md's
# "browser-macos-appkit: building" section) - a large (~1.5GB), unofficial
# mirror of Apple SDK content, not project source. See that section for
# provenance/licensing notes before assuming this is redistributable.
/.macos-sdk
